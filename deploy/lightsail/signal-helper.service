[Unit]
Description=Signal fetch helper
After=network-online.target
Wants=network-online.target

[Service]
User=signal
Group=signal
WorkingDirectory=/opt/signal-helper
ExecStart=/usr/bin/node /opt/signal-helper/fetch-helper.mjs
Environment=HOST=127.0.0.1 PORT=8787 TRUST_PROXY=1 RATE_PER_MIN=20 MAX_RENDERS=2
Restart=on-failure
RestartSec=3
MemoryMax=900M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/signal-helper/.cache

[Install]
WantedBy=multi-user.target

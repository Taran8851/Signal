{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal",
  "version": "0.2.5",
  "identifier": "app.studentos.signal",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-app.mjs",
    "beforeBuildCommand": "node scripts/copy-app.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Signal",
        "url": "research.html",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "Opportunities worth your time",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}

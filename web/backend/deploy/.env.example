# Signal server environment. Copy to deploy/.env ON THE SERVER and fill in real values:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# deploy/.env must never be committed, zipped, or pasted anywhere. Every value below is a placeholder.
# Use no quotes and no spaces around "=" (Docker Compose env_file format).

# --- Hosting -------------------------------------------------------------------------------------

# Hostname Caddy serves and gets a certificate for. Must resolve to this server's public IP.
# Without a domain, use the Elastic IP dashed into sslip.io, e.g. 203.0.113.10 -> 203-0-113-10.sslip.io
SITE_HOST=VPS_HOSTNAME

# Public URL visitors use: the Vercel deployment, no trailing slash. Used as SvelteKit ORIGIN and
# as the base for sign-in callbacks and cookies.
PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app

# --- Database ------------------------------------------------------------------------------------

POSTGRES_USER=signal
# Generate with: openssl rand -hex 24   (hex keeps it URL-safe for DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD
POSTGRES_DB=signal

# Used by web and collector. "postgres" is the compose service name. Keep in sync with the three above.
DATABASE_URL=postgres://signal:CHANGE_ME_HEX_PASSWORD@postgres:5432/signal

# --- Secrets -------------------------------------------------------------------------------------

# Master key that wraps users' LLM API keys (AES-256-GCM). 32 random bytes, base64.
# Generate with: openssl rand -base64 32
# Losing it makes every stored API key unreadable. Store a copy in a password manager, not in the repo.
ENCRYPTION_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Better Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_BASE64_SECRET
# Better Auth base URL. Same value as PUBLIC_ORIGIN.
BETTER_AUTH_URL=https://YOUR-PROJECT.vercel.app

# --- Sign-in providers ---------------------------------------------------------------------------
# Callback URLs registered with each provider must use PUBLIC_ORIGIN (the Vercel URL), not SITE_HOST.
# Exact callback path depends on how web/ mounts Better Auth; confirm before registering.

# GitHub: Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# Google: Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# --- Bots and notifications ----------------------------------------------------------------------

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# From the Discord Developer Portal -> your application -> Bot -> Reset Token. Used by the collector.
DISCORD_BOT_TOKEN=CHANGE_ME

# --- Demo account --------------------------------------------------------------------------------

# Optional: set to false to hide "Try the demo". Name is a placeholder until web/ defines it.
DEMO_ENABLED=true

# --- Backups (read by deploy/backup.sh) ----------------------------------------------------------

# Leave BACKUP_S3_BUCKET empty to keep local copies only.
# Prefer an EC2 instance role with s3:PutObject on this bucket over access keys in this file.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=signal/postgres
# Local directory for dumps (outside the repo so dumps never get zipped or committed).
BACKUP_DIR=/var/backups/signal
# How many local dumps to keep.
BACKUP_KEEP=7

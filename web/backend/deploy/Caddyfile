# Signal: Caddy in front of the web container.
# SITE_HOST comes from web/backend/deploy/.env, e.g. 203-0-113-10.sslip.io. Caddy gets a certificate for it
# automatically, which needs ports 80 and 443 reachable from the internet.

{
	# Optional: address used for Let's Encrypt expiry notices.
	# email you@example.com
}

{$SITE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Placeholder health route. Works before web/ exists, so the Vercel -> VPS rewrite can be
	# tested on day one:
	#   direct:        https://SITE_HOST/healthz
	#   through Vercel: https://<project>.vercel.app/api/healthz
	# Once web/ exists, delete the /api/healthz matcher here and let the app answer it
	# (the compose healthcheck calls the app's own /api/healthz).
	@health path /healthz /api/healthz
	handle @health {
		respond "ok" 200
	}

	handle {
		# Why forwarded headers matter:
		# Visitors see only the Vercel URL. Vercel proxies /console/* and /api/* here, so the Host
		# this server receives is the VPS hostname, not the Vercel one. Sign-in redirects, OAuth
		# callback URLs, SvelteKit's CSRF origin check and cookie domains must all use the Vercel
		# URL, or login breaks (cookies set for the wrong host, "cross-site POST forbidden").
		#
		# By default Caddy trusts no upstream proxy and replaces X-Forwarded-Host with its own
		# view. Vercel's egress IPs are not a fixed list we can put in trusted_proxies, and
		# anyone can reach this host directly, so the header cannot be trusted anyway.
		# Therefore: the app pins its origin from env (ORIGIN / BETTER_AUTH_URL = PUBLIC_ORIGIN)
		# and does NOT derive it from headers. We still pass Vercel's value through under a
		# separate name for logging and debugging only.
		reverse_proxy web:3000 {
			header_up X-Vercel-Forwarded-Host {http.request.header.X-Forwarded-Host}
		}
	}

	log {
		output stdout
		format console
	}
}

# Signal on one Lightsail box: static site + fetch helper. Installed to /etc/caddy/Caddyfile.
# SITE_HOST is set in /etc/default/caddy (e.g. 3-110-178-244.sslip.io).

{$SITE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Fetch helper on loopback. Caddy overwrites X-Forwarded-For, so the helper can trust it.
	handle_path /helper/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/signal
		file_server
	}

	log {
		output stdout
		format console
	}
}
